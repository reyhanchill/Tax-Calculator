DATABASE_URL="postgresql://username:password@host:5432/database?schema=public"

# Required. Signs and verifies session cookies — the app will refuse to start
# without a value at least 32 characters long. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32+-character-secret"

# Base URL used to build links in emails (verification, password reset).
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — outbound email (verification/reset links). If unset, the app
# logs a warning and skips sending instead of failing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="TaxFlow <no-reply@example.com>"
